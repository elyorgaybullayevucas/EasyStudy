# Caddy: avtomatik HTTPS (Let's Encrypt), HTTP -> HTTPS, /api/* -> backend, qolgani -> Next.js
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}

	# Backend API (media oqimi ham shu yerdan: /api/media/..., 2 GB gacha yuklash)
	handle /api/* {
		request_body {
			max_size 2GB
		}
		reverse_proxy backend:8080 {
			transport http {
				read_timeout 30m
				write_timeout 30m
			}
			flush_interval -1
		}
	}
	handle /actuator/health {
		reverse_proxy backend:8080
	}

	# Frontend. Sahifalar faqat o'qiladi: barcha yozish so'rovlari /api/* orqali backendga boradi,
	# Next.js'da "server action"lar ishlatilmaydi. Shuning uchun frontendga GET/HEAD dan boshqa so'rov
	# o'tkazilmaydi - Next.js/React'ning server tomonidagi zaifliklari (2026-11 dagi kabi) aynan
	# POST so'rovi va Next-Action sarlavhasi orqali ishlatiladi.
	handle {
		@notread not method GET HEAD
		respond @notread 405
		@action header Next-Action *
		respond @action 403
		reverse_proxy frontend:3000
	}

	log {
		output file /data/access.log {
			roll_size 20mb
			roll_keep 5
		}
	}
}

# www -> asosiy domen
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
