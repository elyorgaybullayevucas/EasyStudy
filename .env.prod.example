# Production .env (server: cp .env.prod.example .env). Hech qachon git'ga qo'shilmaydi.

# Domen (DNS A yozuvi server IP ga ko'rsatilgan bo'lsin). www ham shu serverga.
DOMAIN=easystudy.uz
ACME_EMAIL=admin@easystudy.uz

# Maxfiy kalitlar - server-setup.sh o'zi yaratadi; qo'lda: openssl rand -base64 48
DB_PASSWORD=
JWT_SECRET=

# Birinchi admin (faqat birinchi ishga tushishda yaratiladi; keyin parolni profilda o'zgartiring va bu qatorlarni bo'sh qoldiring)
DEMO_ADMIN_EMAIL=admin@easystudy.uz
DEMO_ADMIN_PASSWORD=

# Media: local (VPS diski) | s3 (Hetzner Object Storage, Backblaze B2, AWS S3 ...)
MEDIA_PROVIDER=local
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_BUCKET=easystudy-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# AI tekshiruv (Writing/Speaking natijasi darhol): none | claude
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Speaking audio -> matn (Whisper): none | openai
TRANSCRIPTION_PROVIDER=none
OPENAI_API_KEY=
